{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Extra controle voor array- en objectopvragingen, maar dit kan soms onterecht waarschuwen.
    "noUncheckedIndexedAccess": true,

    // Padkoppeling voor nettere imports.
    "paths": {
      "@/*": ["./src/*"]
    },

    // `vue-tsc --build` maakt een .tsbuildinfo-bestand voor incrementele typecontrole.
    // Hier opgegeven zodat het niet in de hoofdmap terechtkomt.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
